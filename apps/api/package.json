{
  "name": "api",
  "type": "module",
  "version": "1.0.0",
  "description": "Hono + oRPC API",
  "author": "Paralect",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/router.d.ts",
      "default": "./src/router.ts"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./src/contract.ts"
    },
    "./resource-client": {
      "types": "./dist/resource-client.d.ts",
      "default": "./src/resource-client.ts"
    }
  },
  "main": "./src/router.ts",
  "types": "./dist/router.d.ts",
  "scripts": {
    "codegen": "tsx scripts/codegen-router.ts && tsx scripts/codegen-db.ts",
    "build": "pnpm codegen && tsc",
    "build:types": "pnpm codegen && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --env-file=.env src/app.ts",
    "start": "tsx --env-file=.env src/app.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:core": "tsx --env-file=.env scripts/seed-core.ts",
    "test:core": "tsx --env-file=.env scripts/verify-core.ts",
    "test:core:e2e": "tsx --env-file=.env scripts/verify-core-browser.ts",
    "schedule": "tsx --env-file=.env src/scheduler/run.ts",
    "seed:university": "tsx --env-file=.env scripts/seed-university.ts",
    "test:university": "tsx --env-file=.env scripts/verify-university.ts",
    "test:university:e2e": "tsx --env-file=.env scripts/verify-university-browser.ts",
    "seed:personal": "tsx --env-file=.env scripts/seed-personal.ts",
    "test:personal": "tsx --env-file=.env scripts/verify-personal.ts",
    "test:personal:e2e": "tsx --env-file=.env scripts/verify-personal-browser.ts",
    "test:lim": "tsx --env-file=.env scripts/verify-lim.ts",
    "test:lim:e2e": "tsx --env-file=.env scripts/verify-lim-browser.ts",
    "seed:home": "tsx --env-file=.env scripts/seed-home.ts",
    "test:home": "tsx --env-file=.env scripts/verify-home.ts",
    "test:home:e2e": "tsx --env-file=.env scripts/verify-home-browser.ts",
    "test:reminder-archive": "tsx --env-file=.env scripts/verify-reminder-archive.ts",
    "test:reminder-archive:e2e": "tsx --env-file=.env scripts/verify-reminder-archive-browser.ts",
    "seed:archive": "tsx --env-file=.env scripts/seed-archive.ts",
    "test:visual": "tsx --env-file=.env scripts/verify-visual-browser.ts",
    "test:runtime:e2e": "tsx --env-file=.env scripts/verify-runtime-browser.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.53",
    "@hono/node-server": "^1.13.0",
    "@orpc/contract": "1.15.6",
    "@orpc/openapi": "1.15.6",
    "@orpc/server": "1.15.6",
    "@orpc/zod": "1.15.6",
    "@scalar/hono-api-reference": "0.10.19",
    "@ship/cloud-storage": "workspace:*",
    "@ship/db": "workspace:*",
    "@ship/emails": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "ai": "6.0.138",
    "app-constants": "workspace:*",
    "better-auth": "^1.0.0",
    "dayjs": "1.11.13",
    "drizzle-orm": "catalog:",
    "hono": "^4.7.0",
    "ioredis": "5.6.1",
    "lodash": "4.18.1",
    "node-schedule": "2.1.1",
    "postgres": "3.4.8",
    "socket.io": "4.8.1",
    "tldts": "7.0.8",
    "winston": "3.17.0",
    "zod": "catalog:",
    "@ship/ai": "workspace:*",
    "@aws-sdk/client-s3": "3.1152.0"
  },
  "devDependencies": {
    "@types/lodash": "4.17.17",
    "@types/node": "catalog:",
    "@types/node-schedule": "2.1.7",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsconfig": "workspace:*",
    "tsx": "4.20.4",
    "typescript": "catalog:"
  }
}
