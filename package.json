{
  "name": "life-hud",
  "scripts": {
    "dev": "node scripts/local.cjs start",
    "start": "node scripts/local.cjs start",
    "setup": "node scripts/local.cjs setup",
    "infra:up": "node scripts/local.cjs infra-up",
    "infra:down": "node scripts/local.cjs infra-down",
    "codegen": "pnpm --filter api codegen",
    "build": "pnpm codegen && turbo run build",
    "typecheck": "pnpm codegen && turbo run typecheck",
    "lint": "eslint apps/api/src apps/api/scripts apps/web/src packages --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:local": "node scripts/local.cjs verify",
    "test:core": "pnpm --filter api test:core",
    "test:core:e2e": "pnpm --filter api test:core:e2e",
    "seed:core": "pnpm --filter api seed:core",
    "db:generate": "pnpm --filter api generate",
    "db:migrate": "pnpm --filter api migrate",
    "db:seed": "pnpm --filter api seed",
    "docs:check": "node scripts/validate-docs.cjs",
    "seed:university": "pnpm --filter api seed:university",
    "test:university": "pnpm --filter api test:university",
    "test:university:e2e": "pnpm --filter api test:university:e2e",
    "seed:personal": "pnpm --filter api seed:personal",
    "test:personal": "pnpm --filter api test:personal",
    "test:personal:e2e": "pnpm --filter api test:personal:e2e",
    "test:lim": "pnpm --filter api test:lim",
    "test:lim:e2e": "pnpm --filter api test:lim:e2e",
    "seed:home": "pnpm --filter api seed:home",
    "test:home": "pnpm --filter api test:home",
    "test:home:e2e": "pnpm --filter api test:home:e2e",
    "test:reminder-archive": "pnpm --filter api test:reminder-archive",
    "test:reminder-archive:e2e": "pnpm --filter api test:reminder-archive:e2e",
    "seed:archive": "pnpm --filter api seed:archive",
    "test:visual": "pnpm --filter api test:visual",
    "test:runtime:e2e": "pnpm --filter api test:runtime:e2e"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "private": true,
  "type": "module"
}
